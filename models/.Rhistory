# save each plot without a legend, all at the same size
plots <- list(p1, p2, p3)
for (i in seq_along(plots)) {
ggsave(paste0("graphs/pl_panel", i, ".pdf"),
plots[[i]] + theme(legend.position = "none"),
width = 2.5, height = 2)
}
