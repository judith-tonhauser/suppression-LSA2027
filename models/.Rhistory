pivot_longer(c(`CC:1`, `CC:1 privately assumed`),
names_to = "measure", values_to = "prob") %>%
mutate(example = "1b")
PL_agg1b
PL_agg1c <- PL1c %>%
filter(qud == "BEL? QUD") %>%
summarise(`CC:1` = sum(prob[CC == 1]),
`CC:1 privately assumed` = sum(prob[pa_type == "CC=1"]),
.groups = "drop") %>%
pivot_longer(c(`CC:1`, `CC:1 privately assumed`),
names_to = "measure", values_to = "prob") %>%
mutate(example = "1c")
PL_agg1c
d = rbind(PL_agg1a,PL_agg1b,PL_agg1c)
d
ggplot(d, aes(x = example, y = prob, fill = measure)) +
geom_col(data = ~ filter(.x, measure == "CC:1"),
width = 0.6) +
geom_col(data = ~ filter(.x, measure == "CC:1 privately assumed"),
width = 0.6) +
scale_fill_manual(values = c("CC:1 observed"         = "grey70",
"CC:1 privately assumed" = "steelblue")) +
scale_y_continuous(limits = c(-.01, 1.01), expand = c(0, 0)) +
labs(x = "example", y = "predicted probability", fill = NULL) +
theme(legend.position = "top")
ggplot(d, aes(x = example, y = prob, fill = measure)) +
geom_col(data = ~ filter(.x, measure == "CC:1"),
width = 0.6) +
geom_col(data = ~ filter(.x, measure == "CC:1 privately assumed"),
width = 0.6) +
scale_fill_manual(values = c("CC:1"         = "grey70",
"CC:1 privately assumed" = "steelblue")) +
scale_y_continuous(limits = c(-.01, 1.01), expand = c(0, 0)) +
labs(x = "example", y = "predicted probability", fill = NULL) +
theme(legend.position = "top")
ggsave("graphs/predProb-by-example.pdf",width=4,height=2.5)
d <- d |> mutate(measure = factor(measure, levels = c("CC:1", "CC:1 privately assumed")))
ggplot(filter(d, measure %in% c("CC:1", "CC:1 privately assumed")),
aes(x = example, y = prob, fill = measure)) +
geom_col(position = position_dodge(width = 0.7), width = 0.6) +
scale_fill_manual(values = c("CC:1"                   = "grey70",
"CC:1 privately assumed" = "steelblue")) +
scale_y_continuous(limits = c(-.01, 1.01), expand = c(0, 0)) +
labs(x = "example", y = "predicted probability", fill = NULL) +
theme(legend.position = "top")
